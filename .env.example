# Substitute credentials/host/database and the path to an existing trusted CA file.
# Never use an administrative role in the API process.
DATABASE_URL=postgresql+psycopg://mod1_backlog_runtime:SUBSTITUA@HOST.neon.tech/neondb?sslmode=verify-full&sslrootcert=C:/CAMINHO/ca.pem
DATABASE_SCHEMA=backlog
JWT_ISSUER=mod1-auth-local
JWT_AUDIENCE=engenharia-software-api
JWKS_URL=http://127.0.0.1:8000/.well-known/jwks.json
PROJECTS_API_BASE_URL=http://127.0.0.1:8001
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Authoritative state and versioned project authorization
AUTH_API_BASE_URL=http://127.0.0.1:8000
AUTH_SESSION_CHECK_ENABLED=true
PROJECTS_LEGACY_ACCESS_ENABLED=false

# Optional AI adapter; empty BASE_URL/MODEL keeps generation disabled
AI_BASE_URL=
AI_MODEL=
AI_SIMULATED=false
AI_TIMEOUT_SECONDS=30
# AI_API_KEY is a server-side secret; never expose in browser configuration

# Proposed code-review ingress: disabled until external producer contract is agreed
CODE_REVIEW_ENABLED=false
CODE_REVIEW_PROJECT_IDS=[]
CODE_REVIEW_EVENT_MAPPING={}
# CODE_REVIEW_KEY: server-side secret (32-512 characters), never place in frontend
